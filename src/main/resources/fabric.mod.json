  "authors": [
    "Noaaan"
  ],
  "contact": {
    "homepage": "https://mythicmetals.com",
    "sources": "https://github.com/Noaaan/MythicMetals",
    "issues": "https://github.com/Noaaan/MythicMetals/issues"
  },
  "license": "MIT",
  "icon": "assets/mythicmetals/icon.png",
